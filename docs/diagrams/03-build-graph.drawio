        <mxCell id="ign" value="&lt;b&gt;.gitignore&lt;/b&gt;&lt;br&gt;.idea/ .vs/ .vscode/&lt;br&gt;cmake-build-*/ build/ out/&lt;br&gt;CMakeUserPresets.json imgui.ini *.user" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
