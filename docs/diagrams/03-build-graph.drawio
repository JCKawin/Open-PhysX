        <mxCell id="ide" value="&lt;b&gt;Observed local trees&lt;/b&gt;&lt;br&gt;build/ — ninja&lt;br&gt;cmake-build-debug/ — CLion Debug&lt;br&gt;cmake-build-release/ — CLion Release&lt;br&gt;Do not commit these." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="360" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n" value="&lt;b&gt;Minimum machine to run today&lt;/b&gt;&lt;br&gt;C++20 compiler, CMake 3.25, OpenGL 3.3-class GPU, network on first configure (FetchContent). No CUDA, no Vulkan SDK, no Python runtime required for the app itself." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
