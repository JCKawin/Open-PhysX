        </mxCell>
        <mxCell id="s" value="&lt;b&gt;cmake -S . -B build&lt;/b&gt;&lt;br&gt;Ninja or VS generator" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
