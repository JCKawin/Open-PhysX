          <mxGeometry x="740" y="120" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="r" value="&lt;b&gt;run executable&lt;/b&gt;&lt;br&gt;creates imgui.ini in CWD" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="280" height="90" as="geometry"/>
