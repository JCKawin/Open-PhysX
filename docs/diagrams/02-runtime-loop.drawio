        <mxCell id="c2" value="&lt;b&gt;kWindowHeight&lt;/b&gt;&lt;br&gt;900" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="220" y="110" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;kTargetFps&lt;/b&gt;&lt;br&gt;60" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;kFixedDt&lt;/b&gt;&lt;br&gt;1 / 60 s" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="580" y="110" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="flags" value="&lt;b&gt;SetConfigFlags&lt;/b&gt;&lt;br&gt;FLAG_WINDOW_RESIZABLE&lt;br&gt;FLAG_VSYNC_HINT&lt;br&gt;FLAG_MSAA_4X_HINT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="780" y="110" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="exitk" value="&lt;b&gt;SetExitKey(KEY_NULL)&lt;/b&gt;&lt;br&gt;ESC does not quit&lt;br&gt;Quit is Ctrl+Q / menu" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1050" y="110" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="&lt;b&gt;1. InitWindow&lt;/b&gt;&lt;br&gt;Open PhysX" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="i2" value="&lt;b&gt;2. SetTargetFPS(60)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="i3" value="&lt;b&gt;3. rlImGuiSetup(true)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="i4" value="&lt;b&gt;4. ImGui IO&lt;/b&gt;&lt;br&gt;NavEnableKeyboard&lt;br&gt;DockingEnable" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="690" y="280" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="i5" value="&lt;b&gt;5. renderer_.init()&lt;/b&gt;&lt;br&gt;16×16 FBO + camera" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="920" y="280" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="i6" value="&lt;b&gt;6. workspace_.init()&lt;/b&gt;&lt;br&gt;apply_theme()" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1170" y="280" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;run loop&lt;/b&gt;&lt;br&gt;while !WindowShouldClose() &amp;amp;&amp;amp; !workspace_.quit_requested()&lt;br&gt;frame()" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="700" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="shut" value="&lt;b&gt;shutdown()&lt;/b&gt;&lt;br&gt;renderer_.shutdown() → UnloadRenderTexture&lt;br&gt;rlImGuiShutdown() → CloseWindow()" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="780" y="420" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n" value="&lt;b&gt;Order matters&lt;/b&gt;&lt;br&gt;GPU objects are created after the GL context (InitWindow) and destroyed before CloseWindow. Do not construct RenderTexture2D in Renderer’s default ctor." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="700" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Settings that change at runtime&lt;/b&gt;&lt;br&gt;Workspace can toggle VSync (FLAG_VSYNC_HINT) and SetTargetFPS(30/60/120/0). The simulation step stays 1/60 regardless of display FPS — see next page." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="780" y="540" width="590" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i1" target="i2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i2" target="i3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i3" target="i4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i4" target="i5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i5" target="i6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i6" target="run">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="exit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="run" target="shut">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rt-frame" name="Frame + timestep">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;One frame — display vs simulation clocks&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Simulation is independent of FPS. Spiral-of-death is not clamped yet (accumulator can run many steps on a hitch)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="dt" value="&lt;b&gt;dt = GetFrameTime()&lt;/b&gt;&lt;br&gt;variable display delta" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="acc" value="&lt;b&gt;accumulator_ += dt&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="while" value="&lt;b&gt;while accumulator_ &amp;gt;= 1/60&lt;/b&gt;&lt;br&gt;simulation_.step(1/60)&lt;br&gt;accumulator_ -= 1/60" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="draw" value="&lt;b&gt;BeginDrawing&lt;/b&gt;&lt;br&gt;ClearBackground (20,20,22)&lt;br&gt;rlImGuiBegin&lt;br&gt;workspace_.draw&lt;br&gt;rlImGuiEnd&lt;br&gt;EndDrawing" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="step" value="&lt;b&gt;Simulation::step(dt)&lt;/b&gt;&lt;br&gt;if !playing: return&lt;br&gt;seek(time + dt * playback_speed)&lt;br&gt;if !loop and time &amp;gt;= duration: playing = false" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="460" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="seek" value="&lt;b&gt;Simulation::seek(time)&lt;/b&gt;&lt;br&gt;duration &amp;lt;= 0 → time = 0&lt;br&gt;loop → fmod wrap into [0, duration)&lt;br&gt;else clamp to [0, duration]" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="530" y="250" width="420" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="vis" value="&lt;b&gt;visual_body()&lt;/b&gt;&lt;br&gt;copy cube&lt;br&gt;if demo_motion: y += sin(time * 3) * 0.25" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="250" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;Display 30 FPS&lt;/b&gt;&lt;br&gt;one frame → two sim steps" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;Display 60 FPS&lt;/b&gt;&lt;br&gt;one frame → one sim step" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;Display 120 FPS&lt;/b&gt;&lt;br&gt;two frames → one sim step&lt;br&gt;(accumulator stores remainder)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="660" y="430" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Uncapped + hitch&lt;/b&gt;&lt;br&gt;many steps in one frame&lt;br&gt;no max-step cap today" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="990" y="430" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="w" value="&lt;b&gt;Target (hardware.md)&lt;/b&gt;&lt;br&gt;Cap steps per frame (e.g. 8). Run sim on a worker. Interpolate visual_body between previous and current state using leftover accumulator / dt. That keeps the UI at display rate while the solver uses every core / the GPU." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dt" target="acc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="acc" target="while">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="then present" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="while" target="draw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="while" target="step">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="step" target="seek">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="render reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="draw" target="vis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rt-ui" name="Workspace UI">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Workspace — default dock layout&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="ImGui DockBuilder splits: right 28% properties, bottom 28% animation, properties bottom 40% tools. Window → Reset Layout rebuilds this." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="menu" value="&lt;b&gt;Main menu bar&lt;/b&gt;   File · Edit · Window · Settings · Quit     shortcuts: Ctrl+N reset · Ctrl+Q quit" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1520" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="vp" value="&lt;b&gt;Viewport&lt;/b&gt;&lt;br&gt;padding 0&lt;br&gt;resize FBO to content size&lt;br&gt;if hovered: orbit / pan / zoom&lt;br&gt;Renderer::render&lt;br&gt;rlImGuiImageRenderTexture&lt;br&gt;FPS + camera help overlay" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
