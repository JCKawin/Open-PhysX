  <diagram id="rt-data" name="Data model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Data model — core/Types.h&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Plain structs. Defaults are the startup scene (blue cube on a dark grid)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="vec" value="&lt;b&gt;Vec3&lt;/b&gt;&lt;br&gt;float x, y, z&lt;br&gt;default 0,0,0" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rgb" value="&lt;b&gt;Rgb&lt;/b&gt;&lt;br&gt;float r,g,b&lt;br&gt;default 0.12, 0.12, 0.14&lt;br&gt;data() → float* for ColorEdit3" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rb" value="&lt;b&gt;RigidBody&lt;/b&gt;&lt;br&gt;Vec3 position {0, 1, 0}&lt;br&gt;Vec3 size {2, 2, 2}&lt;br&gt;Rgb color {0.15, 0.35, 0.85}" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="st" value="&lt;b&gt;SimulationState&lt;/b&gt;&lt;br&gt;time = 0 · duration = 10 · playback_speed = 1&lt;br&gt;playing = false · loop = true&lt;br&gt;show_grid = true · demo_motion = true&lt;br&gt;grid_slices = 20 · grid_spacing = 1&lt;br&gt;clear_color · cube : RigidBody" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="520" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="conv" value="&lt;b&gt;Renderer conversions (anonymous namespace)&lt;/b&gt;&lt;br&gt;to_vec3(Vec3) → raylib Vector3&lt;br&gt;to_color(Rgb) → raylib Color (0–1 clamped to 0–255)&lt;br&gt;wire_color(Rgb) → lighter outline" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="250" width="520" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="w" value="&lt;b&gt;Target layout for max hardware&lt;/b&gt;&lt;br&gt;AoS RigidBody is fine for one cube. A solver that hits millions of bodies needs SoA: pos_x[], pos_y[], pos_z[], inv_mass[], packed 16-byte aligned. SimulationState stays the control block; bodies become a World with chunks. See 05-hardware.drawio." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="410" width="700" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n" value="&lt;b&gt;Why visual_body() exists&lt;/b&gt;&lt;br&gt;UI edits cube.position. Demo motion offsets Y without writing it back. That split is the seed of interpolated render state vs authoritative sim state." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="520" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
