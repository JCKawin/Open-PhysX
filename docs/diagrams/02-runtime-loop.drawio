        <mxCell id="anim" value="&lt;b&gt;Animation Player&lt;/b&gt;&lt;br&gt;⏮  Play/Pause  Stop  ⏭  Loop&lt;br&gt;timeline slider · Duration · Speed" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="900" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cam" value="&lt;b&gt;Viewport camera (keymap, while hovered)&lt;/b&gt;&lt;br&gt;RMB orbit, Shift+RMB pan, Ctrl+RMB zoom&lt;br&gt;Wheel zooms toward the cursor&lt;br&gt;Numpad 1/3/7 axis, 5 persp/ortho, Home frame&lt;br&gt;Turntable quat. Elevation clamped ±1.45 rad&lt;br&gt;Settings can switch orbit to MMB" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
