        <mxCell id="c1" value="&lt;b&gt;kWindowWidth&lt;/b&gt;&lt;br&gt;1600" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="160" height="70" as="geometry"/>
