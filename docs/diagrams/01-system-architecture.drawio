  <diagram id="sys-layout" name="Source layout">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Source layout — what lives where&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="One concern per folder. Logic must stay free of window, GPU, and ImGui types." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="root" value="&lt;b&gt;repository root&lt;/b&gt;&lt;br&gt;CMakeLists.txt — C++20, FetchContent, static deps, Emscripten stub&lt;br&gt;LICENSE — GPL-3.0&lt;br&gt;external/imgui/ — vendored Dear ImGui&lt;br&gt;docs/ — this documentation set" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="520" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="src" value="&lt;b&gt;src/&lt;/b&gt;  (target_include_directories PRIVATE src)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontColor=#F2F2F2;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="mainf" value="&lt;b&gt;main.cpp&lt;/b&gt;&lt;br&gt;process entry only.&lt;br&gt;No engine policy here." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="appf" value="&lt;b&gt;Application.h / .cpp&lt;/b&gt;&lt;br&gt;Window flags, ImGui setup,&lt;br&gt;fixed-step accumulator,&lt;br&gt;owns the three subsystems." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="coref" value="&lt;b&gt;core/Types.h&lt;/b&gt;&lt;br&gt;POD math + SimulationState.&lt;br&gt;No methods that step physics.&lt;br&gt;Safe to include anywhere." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="310" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="logf" value="&lt;b&gt;logic/&lt;/b&gt;&lt;br&gt;ISimulation.h — contract&lt;br&gt;Simulation.h / .cpp — clock,&lt;br&gt;seek/loop, visual_body()." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="360" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="renf" value="&lt;b&gt;renderer/&lt;/b&gt;&lt;br&gt;IRenderer.h — currently includes raylib.h (leak)&lt;br&gt;Renderer.h / .cpp — FBO, camera, DrawCube." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="430" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="uif" value="&lt;b&gt;ui/&lt;/b&gt;&lt;br&gt;Workspace.h / .cpp — theme, dock splits,&lt;br&gt;menus, property editors, timeline widgets." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="430" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="rule1" value="&lt;b&gt;Dependency rule&lt;/b&gt;&lt;br&gt;logic → core only&lt;br&gt;renderer → core + ISimulation + graphics API&lt;br&gt;ui → ISimulation + IRenderer + ImGui&lt;br&gt;Application → all three + raylib/ImGui bootstrap" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="520" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="rule2" value="&lt;b&gt;Do not put here&lt;/b&gt;&lt;br&gt;logic/: Camera3D, Texture, ImGui, HWND&lt;br&gt;core/: stepping, drawing, file I/O&lt;br&gt;ui/: OpenGL calls (blit goes through IRenderer + rlImGui)&lt;br&gt;renderer/: playback policy (play/pause belongs to Simulation)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="590" width="520" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="n" value="&lt;b&gt;Maintenance&lt;/b&gt;&lt;br&gt;When you add a subsystem (assets, serialization, gizmos, solver), give it a folder + an I* contract. Do not grow Application.cpp into a god file. Update this page and architecture.md in the same change." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1120" y="590" width="440" height="160" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sys-contracts" name="Contracts">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Module contracts and ownership&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Interfaces are the stable surface. Implementations can be swapped for headless, SIMD, or GPU backends later." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="is" value="&lt;b&gt;ISimulation&lt;/b&gt;  logic/ISimulation.h&lt;br&gt;&lt;br&gt;void reset()&lt;br&gt;void step(float dt)&lt;br&gt;void seek(float time)&lt;br&gt;SimulationState&amp;amp; state()&lt;br&gt;const SimulationState&amp;amp; state() const&lt;br&gt;RigidBody visual_body() const&lt;br&gt;&lt;br&gt;Comment in code: no window, GPU, or UI types." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="ir" value="&lt;b&gt;IRenderer&lt;/b&gt;  renderer/IRenderer.h&lt;br&gt;&lt;br&gt;void init() / shutdown()&lt;br&gt;void set_viewport_size(w,h)&lt;br&gt;void render(const ISimulation&amp;amp;)&lt;br&gt;const RenderTexture2D&amp;amp; viewport_target() const&lt;br&gt;void update_camera(hovered)&lt;br&gt;void reset_camera()&lt;br&gt;Camera3D&amp;amp; camera()&lt;br&gt;&lt;br&gt;&lt;b&gt;Today:&lt;/b&gt; includes raylib.h — GPU types leak into the contract." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="420" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="ws" value="&lt;b&gt;Workspace&lt;/b&gt;  (no interface yet)&lt;br&gt;&lt;br&gt;void init()&lt;br&gt;void draw(ISimulation&amp;amp;, IRenderer&amp;amp;)&lt;br&gt;bool quit_requested() const&lt;br&gt;&lt;br&gt;Talks only to the two contracts.&lt;br&gt;Does not step the sim (Application does)." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="360" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="app2" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;Simulation simulation_{}&lt;br&gt;Renderer renderer_{}&lt;br&gt;Workspace workspace_{}&lt;br&gt;float accumulator_&lt;br&gt;bool initialized_" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="sim2" value="&lt;b&gt;Simulation final&lt;/b&gt;&lt;br&gt;SimulationState state_{}&lt;br&gt;step() → seek(time + dt * speed) if playing" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ren2" value="&lt;b&gt;Renderer final&lt;/b&gt;  non-copyable&lt;br&gt;RenderTexture2D target_&lt;br&gt;Camera3D + yaw / pitch / distance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="900" y="420" width="360" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="leak" value="&lt;b&gt;Contract leak to close before extra backends&lt;/b&gt;&lt;br&gt;IRenderer returns RenderTexture2D and Camera3D. A Vulkan / WebGPU / headless renderer cannot implement that header. Target: viewport is an opaque handle (texture id + size) and camera is an Open-PhysX type in core/Types.h." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="760" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="own" value="&lt;b&gt;Ownership&lt;/b&gt;&lt;br&gt;Everything is a value member of Application. No unique_ptr, no service locator. Lifetime = window lifetime. Renderer::init after InitWindow; shutdown before CloseWindow." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="830" y="600" width="430" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="calls" value="&lt;b&gt;Who calls whom each frame&lt;/b&gt;&lt;br&gt;1. Application::frame  adds GetFrameTime() to accumulator, steps Simulation at 1/60&lt;br&gt;2. BeginDrawing / ClearBackground&lt;br&gt;3. rlImGuiBegin&lt;br&gt;4. Workspace::draw → viewport resizes FBO, updates camera, Renderer::render, blits FBO&lt;br&gt;5. properties / animation / tools mutate SimulationState and Camera3D&lt;br&gt;6. rlImGuiEnd / EndDrawing" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1220" height="180" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
