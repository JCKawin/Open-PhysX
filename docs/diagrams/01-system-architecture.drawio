        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;What this is today&lt;/b&gt;&lt;br&gt;A dockable 3D workstation shell. Simulation is a playback clock plus a demo sine on one cube. The split (ISimulation vs IRenderer vs Workspace) is the hook for a real solver and extra backends.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not NVIDIA PhysX.&lt;/b&gt; Independent GPL-3 project." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="100" width="340" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Known gaps (see other diagrams)&lt;/b&gt;&lt;br&gt;· IRenderer.h includes raylib.h&lt;br&gt;· Tools (Move/Rotate/Scale) are UI-only&lt;br&gt;· Open / Save / Undo disabled&lt;br&gt;· No collision, no rigid solver&lt;br&gt;· No job system / SIMD / GPU compute" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="400" width="340" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Where to go next&lt;/b&gt;&lt;br&gt;Portability → 04-portability.drawio&lt;br&gt;Max hardware → 05-hardware.drawio&lt;br&gt;Frame timing → 02-runtime-loop.drawio" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;" vertex="1" parent="1">
