        <mxCell id="gl" value="&lt;b&gt;GPU (OpenGL)&lt;/b&gt;&lt;br&gt;MSAA 4x · VSync hint&lt;br&gt;single render thread" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
