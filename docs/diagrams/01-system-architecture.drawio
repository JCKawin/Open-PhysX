        </mxCell>
        <mxCell id="cpu" value="&lt;b&gt;CPU today&lt;/b&gt;&lt;br&gt;one thread does UI + sim + submit&lt;br&gt;fixed 1/60 s step" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;" vertex="1" parent="1">
