<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Open-PhysX docs" version="24.7.17" type="device">
  <diagram id="hw-probe" name="Hardware probe">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Use every useful piece of hardware — probe then assign&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Today none of this exists: one thread does UI + step + GL submit. Target: detect once at init, pick backends, size thread pools." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;Hardware probe (init)&lt;/b&gt;&lt;br&gt;cores · cache line · SIMD ISA · RAM · GPU vendor/memory/queues · battery vs AC" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cpu" value="&lt;b&gt;CPU&lt;/b&gt;&lt;br&gt;logical cores N&lt;br&gt;reserve 1 for UI+OS&lt;br&gt;workers = max(1, N-1)&lt;br&gt;or N-2 if render thread" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="simd" value="&lt;b&gt;SIMD&lt;/b&gt;&lt;br&gt;x64: SSE2 baseline&lt;br&gt;AVX2 / AVX-512 if present&lt;br&gt;ARM: NEON / SVE&lt;br&gt;WASM: simd128" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="gpu" value="&lt;b&gt;GPU&lt;/b&gt;&lt;br&gt;discrete vs iGPU&lt;br&gt;VRAM · compute queues&lt;br&gt;supported API&lt;br&gt;subgroup size" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="210" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="mem" value="&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;body budget from RAM&lt;br&gt;chunked SoA arenas&lt;br&gt;no per-body malloc in step()" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="940" y="210" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="pwr" value="&lt;b&gt;Power / OS&lt;/b&gt;&lt;br&gt;laptop on battery: fewer workers, vsync on&lt;br&gt;headless server: all cores, no vsync" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1240" y="210" width="320" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="dec" value="&lt;b&gt;Decision table (examples)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1520" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;4-core laptop, iGPU, battery&lt;/b&gt;&lt;br&gt;2 sim workers · SSE/AVX2 · GL render · no GPU compute · VSync on · cap 4 substeps" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="730" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;16-core desktop, 8 GB VRAM dGPU&lt;/b&gt;&lt;br&gt;14 workers · AVX2 · GPU broadphase + contact · CPU island solve · uncapped display optional" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="450" width="770" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Browser, 4 cores, WebGPU&lt;/b&gt;&lt;br&gt;1–3 workers (if pthread) else interleaved jobs · WASM SIMD · WebGPU compute if available else CPU" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="730" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;Headless 64-core + 2 GPUs&lt;/b&gt;&lt;br&gt;no UI thread · 64 workers or 1 CPU + 2 GPU queues · batch many worlds · pin NUMA later" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="550" width="770" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="w" value="&lt;b&gt;Maximum hardware ≠ always GPU.&lt;/b&gt; Small worlds are faster on CPU (kernel launch + PCIe). Probe should estimate body count vs transfer cost and keep a CPU fast-path. Never require a vendor SDK to run." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1520" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hw-threads" name="Threads &amp; jobs">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Threading model — from one loop to a job system&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Left = now. Right = target. SimulationState becomes double-buffered." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1520" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="nowt" value="&lt;b&gt;NOW — single thread&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="poll input" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="while accumulator: Simulation::step" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="Workspace::draw + Renderer::render + GL present" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="sleep for VSync / target FPS" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="tgt" value="&lt;b&gt;TARGET — roles&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="760" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;Main / UI thread&lt;/b&gt;&lt;br&gt;window, ImGui, present, camera&lt;br&gt;never runs the solver" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="800" y="170" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;Render submit&lt;/b&gt;&lt;br&gt;can stay on main at first&lt;br&gt;or its own thread later" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1180" y="170" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;Sim control thread&lt;/b&gt;&lt;br&gt;fixed dt loop, publishes snapshot" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="800" y="290" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;Job workers 0..W-1&lt;/b&gt;&lt;br&gt;broadphase, contacts, islands, integrate" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;" vertex="1" parent="1">
          <mxGeometry x="1180" y="290" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;GPU queue(s)&lt;/b&gt;&lt;br&gt;compute dispatch + graphics&lt;br&gt;fences back to sim control" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="410" width="760" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="buf" value="&lt;b&gt;Snapshot protocol&lt;/b&gt;&lt;br&gt;Sim writes WorldSnapshot N+1 while render reads N.&lt;br&gt;UI writes CommandQueue (play, seek, edit cube) consumed at the start of a sim step.&lt;br&gt;visual_body() / future meshes read only the published snapshot — never the in-step SoA." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="700" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="jobs" value="&lt;b&gt;Job system sketch&lt;/b&gt;&lt;br&gt;Work-stealing deque per worker. Parallel-for over body chunks (256–1024 bodies).&lt;br&gt;Islands that touch are a graph: independent islands run in parallel; contacts inside an island stay serial or colored.&lt;br&gt;Web without pthreads: cooperative jobs pumped from the ASYNCIFY loop." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1520" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hw-pipeline" name="Physics pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Physics pipeline — current vs target&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#303030;strokeColor=#1D1D1D;fontColor=#F2F2F2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="Keep this page updated as the solver grows. Each box should name the file that will own it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1620" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="now" value="&lt;b&gt;NOW&lt;/b&gt;  seek(time)  →  visual_body: y += sin(time*3)*0.25  →  DrawCube" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1620" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p0" value="&lt;b&gt;1. Commands&lt;/b&gt;&lt;br&gt;UI edits, spawn, forces" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;2. Integrate&lt;/b&gt;&lt;br&gt;v += a dt · x += v dt&lt;br&gt;semi-implicit Euler" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;3. Broadphase&lt;/b&gt;&lt;br&gt;AABB / sweep SAP / BVH" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;4. Narrowphase&lt;/b&gt;&lt;br&gt;contacts, manifolds" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;5. Islands&lt;/b&gt;&lt;br&gt;union-find wake graph" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1110" y="200" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;6. Solve&lt;/b&gt;&lt;br&gt;PGS / TGS / XPBD" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1360" y="200" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;7. Constraints&lt;/b&gt;&lt;br&gt;joints, motors, limits" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;8. Sleep&lt;/b&gt;&lt;br&gt;deactivate still islands" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#E6E6E6;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p8" value="&lt;b&gt;9. Publish&lt;/b&gt;&lt;br&gt;snapshot for render/UI" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="570" y="320" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p9" value="&lt;b&gt;10. Debug draw&lt;/b&gt;&lt;br&gt;AABBs, contacts, COM" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="840" y="320" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cpu_p" value="&lt;b&gt;CPU fast-path&lt;/b&gt;&lt;br&gt;SoA chunks · SIMD integrate and AABB&lt;br&gt;parallel-for broadphase pairs&lt;br&gt;serial PGS per island (good cache)&lt;br&gt;Best for &amp;lt; ~20k bodies and all headless CI" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#B1DDF0;strokeColor=#368087;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="500" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="gpu_p" value="&lt;b&gt;GPU path (portable compute)&lt;/b&gt;&lt;br&gt;Upload body SoA once per N steps&lt;br&gt;Broadphase + narrowphase in compute&lt;br&gt;Read back contacts or solve on GPU&lt;br&gt;Worth it when pair count dwarfs transfer" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="440" width="540" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="hyb" value="&lt;b&gt;Hybrid (typical workstation)&lt;/b&gt;&lt;br&gt;GPU: broadphase + SDF / mesh contacts&lt;br&gt;CPU: constraint islands, scene queries, UI picks&lt;br&gt;One fence per step; never GL from workers" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;strokeWidth=1.5;arcSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
