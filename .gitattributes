# ===========================================================================
# Open-PhysX .gitattributes
#
# Text normalisation + Git LFS tracking for binary assets.
# Requires "git lfs install" once per machine to enable the LFS filters.
#
# Text-based formats (obj, ply, stl, gltf, csv, dat, opx, cube, usda, ...)
# are intentionally NOT tracked by LFS so they stay diffable in plain git.
# ===========================================================================

# Normalise line endings in the repository, use native endings on checkout.
* text=auto

# Scripts keep predictable endings regardless of platform.
*.sh text eol=lf
*.py text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# ===========================================================================
# Git LFS - binary assets
# ===========================================================================

# --- 3D scenes, simulation & geometry caches ---
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend? filter=lfs diff=lfs merge=lfs -text
*.blend_DISABLED filter=lfs diff=lfs merge=lfs -text
*.bphys filter=lfs diff=lfs merge=lfs -text
